{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["meta", "days"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "subtitle", "days", "new_terms", "review_steps", "version"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "days": {"const": 30},
        "new_terms": {"const": 540},
        "review_steps": {"const": [1, 3, 7, 14, 30]},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "days": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["day", "title", "duration", "new_count", "groups"],
        "additionalProperties": false,
        "properties": {
          "day": {"type": "integer", "minimum": 1, "maximum": 30},
          "title": {"type": "string", "minLength": 1},
          "duration": {"const": "约 30 分钟"},
          "new_count": {"const": 18},
          "groups": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["domain", "title", "icon", "kind", "topic", "intro", "items", "exercises"],
              "additionalProperties": false,
              "properties": {
                "domain": {"enum": ["computer", "daily", "github"]},
                "title": {"type": "string", "minLength": 1},
                "icon": {"type": "string", "minLength": 1},
                "kind": {"type": "string", "minLength": 1},
                "topic": {"type": "string", "minLength": 1},
                "intro": {"type": "string", "minLength": 1},
                "items": {
                  "type": "array",
                  "minItems": 6,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "required": ["id", "term", "key", "meaning", "part", "pos", "speech", "example_speech", "audio_term", "audio_example", "collocation", "example", "explanation", "note"],
                    "additionalProperties": false,
                    "properties": {
                      "id": {"type": "string", "pattern": "^d[0-9]{2}-(computer|daily|github)-[0-9]{2}$"},
                      "term": {"type": "string", "minLength": 1},
                      "key": {"type": "string", "minLength": 1},
                      "meaning": {"type": "string", "minLength": 1},
                      "part": {"type": "string", "minLength": 1},
                      "pos": {"type": "string", "minLength": 1},
                      "speech": {"type": "string", "minLength": 1},
                      "example_speech": {"type": "string", "minLength": 1},
                      "audio_term": {"type": "string", "pattern": "^audio/d[0-9]{2}-(computer|daily|github)-[0-9]{2}-term\\.mp3$"},
                      "audio_example": {"type": "string", "pattern": "^audio/d[0-9]{2}-(computer|daily|github)-[0-9]{2}-example\\.mp3$"},
                      "collocation": {"type": "string", "minLength": 1},
                      "example": {"type": "string", "minLength": 1},
                      "explanation": {"type": "string", "minLength": 1},
                      "note": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "exercises": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "required": ["type", "question", "answer"],
                    "additionalProperties": false,
                    "properties": {
                      "type": {"enum": ["choice", "fill"]},
                      "question": {"type": "string", "minLength": 1},
                      "choices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
                      "answer": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
